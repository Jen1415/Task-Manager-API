# PostgreSQL connection string
# Local (Docker Compose): postgresql://<user>:<password>@db:5432/<dbname>
# Local (native/non-Docker): postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql://user:password@localhost:5432/taskmanager

# Secret key used to sign JWTs. No default — the app will fail to start if missing.
# Generate one with: openssl rand -hex 32
JWT_SECRET=changeme
